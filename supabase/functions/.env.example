# Edge Function secrets (server-side only). Copy to supabase/functions/.env,
# then push with: npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
RESEND_API_KEY=
RESEND_FROM=
